{
  "name": "reddoor-lacquerwares-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-pdfjs-assets.mjs && next dev",
    "build": "node scripts/sync-pdfjs-assets.mjs && next build",
    "start": "next start",
    "demo:tunnel": "node scripts/demo-tunnel.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "seed:products": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed-products.ts",
    "seed:showcase": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed-showcase.ts",
    "migrate": "tsx --env-file-if-exists=.env --conditions=react-server scripts/migrate.ts",
    "backup": "tsx --env-file-if-exists=.env --conditions=react-server scripts/backup.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "import:partners": "tsx --env-file-if-exists=.env --conditions=react-server scripts/import-customers.ts",
    "eval:assistant": "vitest run tests/unit/assistant-eval.test.ts",
    "test:e2e:admin": "playwright test -c playwright.admin.config.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.7.0",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.33.0",
    "mongoose": "^9.9.3",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "react-hook-form": "^7.86.0",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.22.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/page-flip": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
