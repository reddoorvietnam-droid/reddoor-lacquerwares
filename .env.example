# Public origin of the site. It drives every absolute URL search engines see:
# <link rel=canonical>, hreflang, og:url, the robots.txt "Sitemap:" line,
# every sitemap <loc> and the JSON-LD URLs — plus the Zalo OAuth callback and
# the links inside notification e-mails. Production MUST be https://reddoor.vn
# (set in Vercel → Settings → Environment Variables for Production and
# Preview). NEXT_PUBLIC_* values are inlined at build time, so redeploy after
# changing it. `next build` refuses a loopback/http/*.vercel.app origin in
# production mode unless ALLOW_LOOPBACK_SITE_URL=1 is set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local builds/tests only; never set on Vercel. Lets `npm run build`,
# `npm run typecheck` (next typegen) and the Playwright build accept the
# localhost origin above. .env* files are gitignored and Vercel never reads them.
ALLOW_LOOPBACK_SITE_URL=1
DATA_SOURCE=auto

# MongoDB Atlas (required when DATA_SOURCE=mongo)
MONGODB_URI=
MONGODB_DB_NAME=reddoor

# Sign-in is Google only. Create an OAuth client (Web application) in Google
# Cloud Console and add the redirect URI
# <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google (for local development:
# http://localhost:3000/api/auth/callback/google).
# AUTH_SECRET: 32+ random characters. ADMIN_EMAILS: the Director's Gmail; its
# first sign-in becomes the Director, everyone else waits for approval.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=reddoor
MAX_PDF_UPLOAD_MB=10

# Resend
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAILS=

# Scheduled jobs and optional integrations
# CRON_SECRET (32+ chars) protects POST /api/cron/reminders; never reuse AUTH_SECRET.
CRON_SECRET=
# Search engine ownership tokens: the content="…" value of the HTML-tag
# verification method in Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
# Google Maps /maps/place/ or ?cid= link of the claimed Google Business Profile;
# set only after the listing address matches the site (feeds the contact-page map link).
SEO_GOOGLE_MAPS_PLACE_URL=
# IndexNow key (Bing/Yandex/Naver/Seznam). The default lives in src/lib/seo/indexnow.ts
# with its key file in public/; if you override it here, replace public/<key>.txt too.
# INDEXNOW_KEY=

# AI assistant (server-side only). Without a provider key the assistant page
# reports "not configured" and every other admin screen keeps working.
# AI_PROVIDER=anthropic uses Claude (ANTHROPIC_API_KEY; AI_MODEL defaults to
# claude-opus-5). AI_PROVIDER=openai-compatible uses any endpoint speaking the
# OpenAI Chat Completions protocol and needs OPENAI_COMPAT_BASE_URL,
# OPENAI_COMPAT_API_KEY and an explicit AI_MODEL — for Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai/ with an AI Studio
# key and AI_MODEL=gemini-2.5-flash (free tier: demo data only).
# AI_PROVIDER=mock is a scripted development provider, refused in production.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_REASONING_EFFORT=
AI_MODEL=claude-opus-5
AI_MAX_TOOL_ROUNDS=6
# Per-round model timeout. Keep it below the deployed function's own ceiling
# (Vercel: `maxDuration`, 120 s on the chat route) so the loop can report a
# slow model instead of the connection simply dying.
AI_REQUEST_TIMEOUT_MS=90000

# Reminders. NOTIFICATION_DELIVERY=off records intents without sending;
# test redirects everything to NOTIFICATION_TEST_RECIPIENT; live sends for real.
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
NOTIFICATION_DELIVERY=off
NOTIFICATION_TEST_RECIPIENT=
REMINDER_LEAD_DAYS=1
REMINDER_QUIET_HOURS=21-7

# Zalo Official Account: app id, app secret key (OAuth) and OA secret key
# (webhook signature). No token here — the Director presses "Connect Zalo" on
# /admin/settings once; the token pair is stored in MongoDB and renewed by the
# platform. Register on the Zalo app: webhook https://<domain>/api/zalo/webhook
# and OAuth callback https://<domain>/api/zalo/oauth/callback.
ZALO_APP_ID=
ZALO_APP_SECRET_KEY=
ZALO_OA_SECRET_KEY=


# Optional, DEVELOPMENT ONLY: DEV_OPEN_ACCESS=true lets every signed-in user
# pass every permission check at global scope (RBAC is bypassed entirely).
# Never set this in a deployed environment.
# DEV_OPEN_ACCESS=
