# Public application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATA_SOURCE=auto

# MongoDB Atlas (required when DATA_SOURCE=mongo)
MONGODB_URI=
MONGODB_DB_NAME=reddoor

# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=reddoor
MAX_PDF_UPLOAD_MB=10

# Resend
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAILS=

# Scheduled jobs and optional integrations
# CRON_SECRET (32+ chars) protects POST /api/cron/reminders; never reuse AUTH_SECRET.
CRON_SECRET=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# AI assistant (server-side only). Without a provider key the assistant page
# reports "not configured" and every other admin screen keeps working.
# AI_PROVIDER=anthropic uses Claude (ANTHROPIC_API_KEY; AI_MODEL defaults to
# claude-opus-5). AI_PROVIDER=openai-compatible uses any endpoint speaking the
# OpenAI Chat Completions protocol and needs OPENAI_COMPAT_BASE_URL,
# OPENAI_COMPAT_API_KEY and an explicit AI_MODEL — for Gemini:
# https://generativelanguage.googleapis.com/v1beta/openai/ with an AI Studio
# key and AI_MODEL=gemini-2.5-flash (free tier: demo data only).
# AI_PROVIDER=mock is a scripted development provider, refused in production.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_REASONING_EFFORT=
AI_MODEL=claude-opus-5
AI_MAX_TOOL_ROUNDS=6
# Per-round model timeout. Keep it below the deployed function's own ceiling
# (Vercel: `maxDuration`, 120 s on the chat route) so the loop can report a
# slow model instead of the connection simply dying.
AI_REQUEST_TIMEOUT_MS=90000

# Reminders. NOTIFICATION_DELIVERY=off records intents without sending;
# test redirects everything to NOTIFICATION_TEST_RECIPIENT; live sends for real.
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
NOTIFICATION_DELIVERY=off
NOTIFICATION_TEST_RECIPIENT=
REMINDER_LEAD_DAYS=1
REMINDER_QUIET_HOURS=21-7

# Zalo Official Account: app id, app secret key (OAuth) and OA secret key
# (webhook signature). No token here — the Director presses "Connect Zalo" on
# /admin/settings once; the token pair is stored in MongoDB and renewed by the
# platform. Register on the Zalo app: webhook https://<domain>/api/zalo/webhook
# and OAuth callback https://<domain>/api/zalo/oauth/callback.
ZALO_APP_ID=
ZALO_APP_SECRET_KEY=
ZALO_OA_SECRET_KEY=


# Optional, DEVELOPMENT ONLY: any value enables one-click role-preview
# sign-in on /admin/sign-in (one entry per system role, no password asked).
# Never set this in a deployed environment.
# DEV_LOGIN_PASSWORD=

# Optional, DEVELOPMENT ONLY: DEV_OPEN_ACCESS=true lets every signed-in user
# pass every permission check at global scope (RBAC is bypassed entirely).
# Never set this in a deployed environment.
# DEV_OPEN_ACCESS=
